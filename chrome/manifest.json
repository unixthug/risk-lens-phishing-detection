{
  "manifest_version": 3,
  "name": "RiskLens",
  "version": "0.5.0",
  "description": "Scores sites for phishing risk and warns before loading dangerous pages.",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://risklens-gw-2eqv4bws.uc.gateway.dev/*"
  ],
  "action": {
    "default_title": "RiskLens",
    "default_popup": "popup.html",
    "default_icon": "icons/safe.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.js",
        "icons/safe.png",
        "icons/sus.png",
        "icons/danger.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
