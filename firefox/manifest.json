{
  "manifest_version": 2,
  "name": "RiskLens",
  "version": "0.5.1",
  "description": "Scores sites for phishing risk and can warn/block navigation with an interstitial.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "https://risklens-gw-2eqv4bws.uc.gateway.dev/*"
  ],
  "browser_action": {
    "default_title": "RiskLens",
    "default_popup": "popup.html",
    "default_icon": "icons/safe.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "risk-lens@yourdomain.com",
      "data_collection_permissions": {
        "required": ["browsingActivity"],
        "optional": []
      }
    }
  },
  "web_accessible_resources": [
    "warning.html",
    "warning.js",
    "checking.html",
    "checking.js",
    "icons/safe.png",
    "icons/sus.png",
    "icons/danger.png"
  ]
}
